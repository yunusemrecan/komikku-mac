using Gtk 4.0;
using Adw 1;

template $TrackingDialog : Adw.PreferencesDialog {
  title: _("Tracking");
  presentation-mode: bottom_sheet;

  Adw.PreferencesPage {
    name: "trackers";
    description-centered: true;

    Adw.PreferencesGroup group {
      separate-rows: true;
    }
  }
}
